{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-flash-latest",
  "disabled_providers": ["opencode"],
  "provider": {
    "google": {
      "options": {
        "apiKey": "<GEMINI_API_KEY>",
        "retry": {
          "maxRetries": 5,
          "baseDelayMs": 2000,
          "maxDelayMs": 30000
        }
      }
    }
  }
}